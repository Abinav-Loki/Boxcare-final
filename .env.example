# Box Care environment example.
# Copy this file to .env.local for local development.
# Never commit real secrets in .env.local or any production env file.

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth
# Use AUTH_* for Auth.js. NEXTAUTH_* names are kept only if the team chooses legacy naming.
AUTH_SECRET="replace-with-local-development-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-local-development-secret-if-needed"
NEXTAUTH_URL="http://localhost:3000"

# CCAvenue
CCAVENUE_MERCHANT_ID=""
CCAVENUE_ACCESS_CODE=""
CCAVENUE_WORKING_KEY=""
CCAVENUE_MODE="test"
CCAVENUE_REDIRECT_URL="http://localhost:3000/api/ccavenue/response"
CCAVENUE_CANCEL_URL="http://localhost:3000/api/ccavenue/cancel"

# Email
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Box Care <orders@example.com>"

# Storage
STORAGE_PROVIDER="local"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
